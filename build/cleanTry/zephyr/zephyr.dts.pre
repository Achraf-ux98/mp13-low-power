/ {
 soc {
  compatible = "st,stm32mp135", "st,stm32mp13", "simple-bus";

  dcmipp: dcmipp@5a000000 {
   compatible = "st,stm32-dcmipp";
   reg = <0x5a000000 0x400>;
   interrupts = <0x0 79 (1UL << (1)) 0xa0>;
   interrupt-names = "dcmipp";
   clocks = <&rcc (0x728) (1 << 1)>,
     <&rcc (((((0x003 + 1) + 1) + 1) + 1) + 1) ((((0x664) & 0xFFFFU) << 0U) | (((0) & 0x1FU) << 16U) | ((((1) - (0)) & 0x3U) << 21U) | ((((1)) & 0xFFU) << 24U))>;
   clock-names = "dcmipp", "dcmipp-ker";
   resets = <&rctl (((0x6BC) << 17U) | ((0x6B8) << 5U) | (1))>;
   status = "disabled";

   pipe_dump: pipe {};

