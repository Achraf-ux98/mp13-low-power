    #gpio-cells = <2>;
    clocks = <&rcc (0x768) (1 << 1)>;
   };

   gpioc: gpio@50004000 {
    compatible = "st,stm32-gpio";
    reg = <0x50004000 0x400>;
    gpio-controller;
    #gpio-cells = <2>;
    clocks = <&rcc (0x768) (1 << 2)>;
   };

   gpiod: gpio@50005000 {
    compatible = "st,stm32-gpio";
    reg = <0x50005000 0x400>;
    gpio-controller;
    #gpio-cells = <2>;
    clocks = <&rcc (0x768) (1 << 3)>;
   };

   gpioe: gpio@50006000 {
    compatible = "st,stm32-gpio";
    reg = <0x50006000 0x400>;
    gpio-controller;
    #gpio-cells = <2>;
    clocks = <&rcc (0x768) (1 << 4)>;
   };

   gpiof: gpio@50007000 {
    compatible = "st,stm32-gpio";
    reg = <0x50007000 0x400>;
    gpio-controller;
    #gpio-cells = <2>;
    clocks = <&rcc (0x768) (1 << 5)>;
   };

   gpiog: gpio@50008000 {
    compatible = "st,stm32-gpio";
    reg = <0x50008000 0x400>;
    gpio-controller;
    #gpio-cells = <2>;
    clocks = <&rcc (0x768) (1 << 6)>;
   };

   gpioh: gpio@50009000 {
    compatible = "st,stm32-gpio";
